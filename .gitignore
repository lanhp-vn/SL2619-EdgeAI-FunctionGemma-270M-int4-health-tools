# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
.eggs/

# Virtual envs
.venv/
venv/

# Tool caches
.cache/
.coverage
.coverage.*
htmlcov/

# Large model artifacts (keep metadata; exclude weights)
*.gguf
*.bin
*.safetensors
*.pt
*.pth
*.ckpt
# Distil-side model bundles (HF weights + LoRA + GGUF packed into a single tarball;
# the extracted contents are kept locally but the bundle itself is huge and redundant
# once extracted).
*.tar

# Fine-tune checkpoints (large; use explicit git-add if you want a specific one)
checkpoints/

# Secrets
.env
*.local

# Claude Code local config (machine-specific; skills/ and agents/ are tracked in git)
.claude
.codex

# Synaptics reference submodule build artifacts
# (submodules are update=none; these patterns guard against accidental staging if initialized)
docs/references/upstream/Synaptics/*/build/
docs/references/upstream/Synaptics/*/dist/
docs/references/upstream/Synaptics/*/out/
docs/references/upstream/Synaptics/*/*.ko
docs/references/upstream/Synaptics/*/Module.symvers
docs/references/upstream/Synaptics/*/modules.order

# /board_probe + server-probe snapshots — local only, contain personal info
docs/tmp/
